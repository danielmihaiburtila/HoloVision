<?xml version="1.0" encoding="utf-8"?>
<grammar version="1.0" xml:lang="ro-RO" mode="voice" root="root"
         xmlns="http://www.w3.org/2001/06/grammar"
         tag-format="semantics/1.0">

  <rule id="root">
    <one-of>
      <!-- meniu -->
      <item> start </item>
      <item> exit </item>
      <item> inapoi </item>
      <item> meniu </item>

      <!-- features -->
      <item> descriere </item>
      <item> citire </item>
      <item> siguranta </item>
      <item> liniste </item>

      <!-- stop global -->
      <item> stop </item>
      <item> gata </item>
      <item> opreste </item>
      <item> termina </item>

      <!-- stop find -->
      <item> opreste cautarea </item>
      <item> stop cautarea </item>
      <item> anuleaza cautarea </item>

      <!-- FIND: comenzi + intrebari -->
      <item>
        <ruleref uri="#findPrefix"/>
        <ruleref uri="#objectName"/>
      </item>
    </one-of>
  </rule>

  <rule id="findPrefix">
    <one-of>
      <item> cauta </item>
      <item> gaseste </item>
      <item> unde e </item>
      <item> unde este </item>
      <item> unde sunt </item>
      <item> unde mi-am pus </item>
      <item> unde mi am pus </item>
    </one-of>
  </rule>

  <rule id="objectName">
    <one-of>
      <item> telefon </item>
      <item> telefonul </item>
      <item> chei </item>
      <item> cheile </item>
      <item> portofel </item>
      <item> portofelul </item>
      <item> usa </item>
      <item> scaun </item>
      <item> scaunul </item>
      <item> masa </item>
      <item> masa </item>
    </one-of>
  </rule>
</grammar>