--- !u!114 &1897953903
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1897953902}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c7f6fb45c68bd0b408fc77a1be55178a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  azureTTS: {fileID: 508451171}
  speechUI: {fileID: 174867830}
  menuUI: {fileID: 174867831}
  scanHandler: {fileID: 1897953908}
  sceneAI: {fileID: 2018126930}
  ocrSystem: {fileID: 1694046470}
  productScanner: {fileID: 1350699063}
  objectFinder: {fileID: 936652089}
  welcomeMessage: "Sistemul HoloVision a fost activat. Sunt gata s\u0103 te asist.
    Spune START ca s\u0103 intri \xEEn meniul op\u021Biunilor sau EXIT ca s\u0103
    p\u0103r\u0103se\u0219ti aplica\u021Bia."
  goodbyeMessage: "Sistemul HoloVision se \xEEnchide. Pe cur\xE2nd!"
  commandCooldown: 0.6
  cameraSettleDelay: 1
  requireFindPrefix: 1
  logFindParsing: 1
  allowFindWithoutPrefixFallback: 0
  implicitFindMaxTokens: 4
  enableTwoStepFind: 1
  twoStepFindTimeout: 8
  sos: {fileID: 763872176}
  lightBill: {fileID: 1337141681}
  walkingSafety: {fileID: 301247897}
  bulbCheck: {fileID: 1393364367}
  activeFeatureText: {fileID: 0}
  searchResultUI: {fileID: 0}
  CurrentMode: 0
  startupIntroMessage: "HoloVision a fost activat. Sunt aici s\u0103 te ajut cu orientarea,
    citirea textului, identificarea obiectelor \u0219i func\u021Biile de siguran\u021B\u0103."
  vocalModeActivatedMessage: "Modul vocal a fost activat. Po\u021Bi \xEEncepe prin
    comenzi vocale."
  discreetModeActivatedMessage: "Modul discret a fost activat. Po\u021Bi folosi telefonul
    pentru a trimite comenzile."
  allowCriticalVoiceCommandsInDiscreetMode: 1
  featuresAnnouncementDelay: 0.9
  listeningShowDelay: 3
  modeSelectionDelay: 4.5
  featuresMessage: "Meniul op\u021Biunilor este activ. Pe telefon, \xEEn col\u021Bul
    din st\xE2nga sus se afl\u0103 Descrierea mediului. \xCEn col\u021Bul din dreapta
    sus se afl\u0103 Citirea textului. \xCEn zona central\u0103 se afl\u0103 C\u0103utarea
    unui obiect. \xCEn col\u021Bul din st\xE2nga jos se afl\u0103 Scanarea produsului.
    \xCEn col\u021Bul din dreapta jos se afl\u0103 verificarea pentru factura de
    curent. \xCEn orice moment, po\u021Bi opri func\u021Bia activ\u0103 prin ap\u0103sare
    continu\u0103 pe ecranul telefonului sau prin gestul de stop pe HoloLens. Totodat\u0103,
    exist\u0103 gestul rapid pentru timp: ridic\u0103 m\xE2na st\xE2ng\u0103 \u0219i
    uit\u0103-te spre ea ca la un ceas \u0219i \xEE\u021Bi voi spune ziua \u0219i
    ora curent\u0103."
  vocalFeaturesMessage: "Meniul op\u021Biunilor este activ. \xCE\u021Bi voi prezenta
    func\u021Biile disponibile \u0219i comenzile vocale pe care le po\u021Bi folosi.
    Pentru descrierea mediului, op\u021Biunea se afl\u0103 \xEEn col\u021Bul din
    st\xE2nga sus al telefonului. Po\u021Bi spune DESCRIERE. Pentru citirea textului,
    op\u021Biunea se afl\u0103 \xEEn col\u021Bul din dreapta sus. Po\u021Bi spune
    TEXT. Pentru c\u0103utarea unui obiect, op\u021Biunea se afl\u0103 \xEEn zona
    central\u0103. Po\u021Bi spune CAUT\u0102, urmat de numele obiectului, de exemplu:
    CAUT\u0102 TELEFONUL sau CAUT\u0102 OCHELARII. Pentru scanarea unui produs, op\u021Biunea
    se afl\u0103 \xEEn col\u021Bul din st\xE2nga jos. Po\u021Bi spune SCANEAZ\u0102
    PRODUS. Pentru verificarea luminii sau a consumului inutil de curent, op\u021Biunea
    se afl\u0103 \xEEn col\u021Bul din dreapta jos. Po\u021Bi spune FACTURA CURENT.
    \xCEn orice moment, po\u021Bi opri func\u021Bia activ\u0103 spun\xE2nd STOP,
    prin ap\u0103sare continu\u0103 pe telefon sau prin gestul de stop cu palma.
    Totodat\u0103, exist\u0103 gestul rapid pentru timp: ridic\u0103 m\xE2na st\xE2ng\u0103
    \u0219i uit\u0103-te spre ea ca la un ceas \u0219i \xEE\u021Bi voi spune ziua
    \u0219i ora."
  modeSelectionMessage: "Alege modul de utilizare. Pe telefon, ecranul este \xEEmp\u0103r\u021Bit
    \xEEn dou\u0103 zone. \xCEn jum\u0103tatea de sus se afl\u0103 modul vocal. \xCEn
    jum\u0103tatea de jos se afl\u0103 modul discret. \xCEn modul vocal po\u021Bi
    folosi at\xE2t comenzile vocale, c\xE2t \u0219i telefonul. \xCEn modul discret
    folose\u0219ti telefonul pentru controlul aplica\u021Biei. Spune MOD VOCAL sau
    MOD DISCRET, ori apas\u0103 pe zona corespunz\u0103toare de pe telefon."
  unknownVocalCommandMessage: "Nu am \xEEn\u021Beles comanda. Te rog repet\u0103
    folosind una dintre comenzile disponibile: DESCRIERE, TEXT, CAUT\u0102 urmat
    de numele obiectului, SCANEAZ\u0102 PRODUS sau FACTURA CURENT."
  unknownCommandSpeakCooldown: 3
  startupAskNameMessage: "Bine ai venit \xEEn HoloVision. Pentru a face cuno\u0219tin\u021B\u0103
    apas\u0103 pe ecranul telefonului si spune-mi numele t\u0103u."
  retryUserNameMessage: "Repet\u0103, te rog, numele."
  askUserNameOnce: 1
  askUserNameAfterModeSelection: 1
  includeUserNameInStartupGreeting: 1
  askUserNameMessage: 
  skipUserNameMessage: 
  userNameSavedTemplate: "\xCEnc\xE2ntat de cuno\u0219tin\u021B\u0103, {0}."
  returningUserGreetingTemplate: Bine ai venit, {0}!
